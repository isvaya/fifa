# Создайте бота у @BotFather, вставьте токен:
TELEGRAM_BOT_TOKEN=

# ID чата (личка с ботом или группа). Узнать: написать боту, открыть
# https://api.telegram.org/bot<TOKEN>/getUpdates и взять chat.id
TELEGRAM_CHAT_ID=

# Локально по умолчанию 8787; на Railway переменную PORT задаёт платформа — не дублировать.
PORT=8787

# Обязательно в проде: иначе браузер заблокирует запрос с сайта.
# Через запятую, без слэша в конце. Пример GitHub Pages + Vite:
# ALLOWED_ORIGINS=https://isvaya.github.io,http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=
