# Заявки с формы ORDER: https://formspree.io — id из URL …/f/ВАШ_ID (только в .env, не в git)
VITE_FORMSPREE_FORM_ID=

# Параллельно с Formspree: бэкенд (Railway и т.п.) — полный URL до эндпоинта, например:
# VITE_ORDER_API_URL=https://fifa-form-telegram-production-xxxx.up.railway.app/api/order
VITE_ORDER_API_URL=

# Если Formspree не используете: при отправке откроется почтовый клиент (укажите ваш e-mail)
VITE_ORDER_EMAIL=
